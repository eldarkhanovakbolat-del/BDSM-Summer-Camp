# 前端服务在服务器内部访问夏令营 API。默认值通常不用改。
CAMP_SERVER_URL=http://127.0.0.1:8765

# 留空时浏览器只访问同域 /api，由前端安全转发到 CAMP_SERVER_URL。
# 只有明确需要浏览器直连另一地址时才填写。
NEXT_PUBLIC_CAMP_API_BASE=

# 夏令营服务端
CAMP_BIND_HOST=127.0.0.1
CAMP_PORT=8765
CAMP_DB_PATH=./data/camp.db
CAMP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 默认 AI 适配器：任何兼容 OpenAI Chat Completions 的后端都可以使用。
AI_PROVIDER=openai_compatible
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=180
AI_MAX_CONCURRENT=2

# 只有后端不会自动注入原有人设时才填写。文件不应提交到仓库。
AI_PERSONA_FILE=

# 可选：某些自建网关需要额外请求头，填写 JSON；不要提交真实值。
AI_EXTRA_HEADERS_JSON={}
AI_EXTRA_BODY_JSON={}

# 可选：让文字 AI 观众使用另一个不注入主 AI 人设/记忆的模型端点。
# 全部留空时，观众复用上面的 AI Provider，但仍使用独立 purpose 与会话标识。
AUDIENCE_AI_PROVIDER=
AUDIENCE_AI_BASE_URL=
AUDIENCE_AI_API_KEY=
AUDIENCE_AI_MODEL=
AUDIENCE_AI_TIMEOUT_SECONDS=
AUDIENCE_AI_MAX_CONCURRENT=
AUDIENCE_AI_EXTRA_HEADERS_JSON=
AUDIENCE_AI_EXTRA_BODY_JSON=

# 长期记忆默认关闭。已有记忆系统时可改成 http，或让 AI 新增适配器。
MEMORY_PROVIDER=off
MEMORY_BASE_URL=http://127.0.0.1:8001
MEMORY_API_KEY=
MEMORY_RECALL_PATH=/recall
MEMORY_REMEMBER_PATH=/remember
MEMORY_TIMEOUT_SECONDS=20
